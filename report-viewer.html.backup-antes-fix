  const renderCountry = (base, currency) => base.accounts.length ? base.accounts.map(account => `<tr><td>${esc(account.bank)}</td><td>${esc(account.account)}</td><td class="num">${money(account.final, currency)}</td><td><span class="badge">${reviewCount ? 'REVISAR' : 'OK'}</span></td></tr>`).join('') : '<tr><td colspan="4" class="empty-state">Sin datos de este país.</td></tr>';
  gtTable.innerHTML = renderCountry(gt, 'GTQ');
  svTable.innerHTML = renderCountry(sv, 'USD');
  review.textContent = reviewCount ? `${reviewCount} registro(s) requieren revisión según la conciliación de Make.com.` : 'No hay registros pendientes de revisión.';
  document.getElementById('generalStatus').textContent = gt.banks.length || sv.banks.length ? 'Procesado por Make' : 'Sin datos';
  document.getElementById('regionalStatus').textContent = CONSOLIDATION.regional.length ? 'Procesado por Make' : 'Sin datos';
}

