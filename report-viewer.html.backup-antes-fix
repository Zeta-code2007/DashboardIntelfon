<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RED INTELFON - Saldos Bancarios Consolidados</title>

<!-- SheetJS (xlsx) CDN -->
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<!-- html2pdf.js CDN para Descarga Directa de PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
  :root{
    --bg:#171A21;--panel:#222631;--panel2:#292E3A;--soft:#323846;--text:#F8FAFC;--muted:#AAB4C3;
    --line:#3B4352;--green:#34D399;--blue:#60A5FA;--amber:#FBBF24;--red:#FB7185;--purple:#A78BFA;
    --intelfon-red:#DC2626;--intelfon-red-hover:#B91C1C;
    --shadow:0 16px 40px rgba(0,0,0,.22);
  }
  *{box-sizing:border-box}
  body{margin:0;background:radial-gradient(circle at 10% -10%,#27334a 0,transparent 35%),linear-gradient(180deg,#171A21,#12151B 80%);color:var(--text);font-family:Inter,'Segoe UI',Arial,sans-serif;min-height:100vh;letter-spacing:.005em}
  .app{max-width:1500px;margin:auto;padding:28px}
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,430px);justify-content:space-between;gap:28px;align-items:start;background:linear-gradient(135deg,#2B3040 0%,#232835 55%,#1C222D 100%);border:1px solid #3C4454;border-radius:24px;padding:26px 28px;box-shadow:var(--shadow);position:relative;overflow:hidden}
  .hero:after{content:"";position:absolute;width:320px;height:320px;border-radius:50%;background:linear-gradient(135deg,rgba(220,38,38,.18),rgba(96,165,250,.08));right:-90px;top:-140px}
  .hero-left{position:relative;z-index:1}
  .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#F87171;font-weight:800}
  h1{margin:8px 0 7px;font-size:clamp(26px,4vw,42px);letter-spacing:-.035em}
  .sub{color:var(--muted);font-size:14px;line-height:1.55}
  .hero-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;position:relative;z-index:1;justify-content:stretch}
  .hero-actions button{width:100%;min-height:40px;white-space:nowrap}
  .btn-clear-dashboard{background:#374151;border-color:#64748B;color:#F8FAFC}
  .btn-clear-dashboard:hover{background:#4B5563;border-color:#94A3B8}
  button,.select{border:1px solid #465064;background:#2C3340;color:var(--text);padding:10px 14px;border-radius:12px;font-weight:700;cursor:pointer;transition:all 0.2s}
  button:hover{background:#374151}
  .btn-primary-red{background:linear-gradient(135deg,#DC2626,#B91C1C);border-color:#EF4444;color:#FFFFFF}
  .btn-primary-red:hover{background:linear-gradient(135deg,#B91C1C,#991B1B)}
  .btn-excel{background:#059669;border-color:#10B981;color:#FFFFFF}
  .btn-excel:hover{background:#047857}
  .meta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:18px;max-width:900px}
  .meta span{background:#1E2430;border:1px solid #3A4352;color:#C7D2E0;border-radius:999px;padding:7px 10px;font-size:12px}
  .date-filter{display:flex;align-items:center;gap:7px;flex-wrap:wrap;background:#1E2430;border:1px solid #3A4352;color:#C7D2E0;border-radius:16px;padding:5px 6px 5px 11px;font-size:11px;box-shadow:0 6px 16px rgba(0,0,0,.10)}
  .date-filter-title{font-weight:850;color:#DCE6F4;margin-right:1px;white-space:nowrap}
  .date-filter label{display:flex;align-items:center;gap:5px;color:#94A3B8;font-size:10px;font-weight:750;white-space:nowrap}
  .date-filter input[type="date"]{width:124px;border:1px solid #465064;background:#252C37;color:#F8FAFC;border-radius:9px;padding:5px 7px;font:700 10px Inter,'Segoe UI',Arial,sans-serif;outline:none;color-scheme:dark}
  .date-filter input[type="date"]:focus{border-color:#60A5FA;box-shadow:0 0 0 2px rgba(96,165,250,.13)}
  .date-sep{color:#687386;font-weight:800}
  .date-apply,.date-reset{border:1px solid #4A5A72;background:#334155;color:#F8FAFC;padding:6px 9px;border-radius:9px;font-size:10px;font-weight:800;cursor:pointer}
  .date-apply:hover,.date-reset:hover{background:#41516A}
  .date-reset{min-width:30px;padding-left:8px;padding-right:8px}
  .tabs{display:flex;gap:9px;margin:22px 0 16px;flex-wrap:wrap}
  body.embedded-overview .tabs{display:none}
  .tab{background:#222832;border:1px solid #394252;color:#C5CEDA}
  .tab.active{background:#DC2626;color:#FFFFFF;border-color:#DC2626}
  .section{display:none}.section.active{display:block;animation:sectionIn .28s ease both}
  @keyframes sectionIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .kpis{display:grid;grid-template-columns:repeat(3,minmax(220px,1fr));gap:14px}
  .kpi{background:linear-gradient(180deg,#262B36,#20252F);border:1px solid #3A4250;border-radius:18px;padding:18px;box-shadow:0 10px 24px rgba(0,0,0,.12)}
  .kpi .label{font-size:12px;color:#AEB8C8;text-transform:uppercase;letter-spacing:.07em;font-weight:800}
  .kpi .value{font-size:clamp(20px,2vw,29px);font-weight:850;margin:8px 0 4px;letter-spacing:-.03em}
  .kpi .hint{font-size:12px;color:#8F9AAA}
  .positive{color:#6EE7B7!important}.negative{color:#FDA4AF!important}.neutral{color:#93C5FD!important}
  .grid2{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:16px}
  .grid-equal{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
  .card{background:linear-gradient(180deg,#242A34,#1E232C);border:1px solid #39414F;border-radius:20px;padding:20px;box-shadow:var(--shadow);position:relative;transition:transform .25s cubic-bezier(0.16, 1, 0.3, 1),border-color .25s ease,box-shadow .25s ease}
  .card:hover{border-color:#4F5B6F;box-shadow:0 20px 45px rgba(0,0,0,.35)}
  .card h2{font-size:17px;margin:0 0 4px;letter-spacing:-.01em}
  .card .desc{font-size:12px;color:#94A0B2;margin-bottom:16px}
  canvas{width:100%;height:330px;display:block;cursor:crosshair;filter:drop-shadow(0 4px 10px rgba(0,0,0,0.12))}
  .chart-tooltip{position:absolute;z-index:20;display:flex;flex-direction:column;gap:5px;min-width:170px;max-width:260px;padding:12px 14px;border:1px solid rgba(96,165,250,.35);border-radius:12px;background:rgba(15,23,42,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 18px 36px rgba(0,0,0,.45);color:#CBD5E1;font-size:11px;line-height:1.4;pointer-events:none;opacity:0;transform:translateY(6px) scale(.97);transition:opacity .18s ease,transform .18s cubic-bezier(0.16, 1, 0.3, 1)}
  .chart-tooltip.visible{opacity:1;transform:translateY(0) scale(1)}
  .chart-tooltip strong{color:#F8FAFC;font-size:12.5px;font-weight:800;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:4px;margin-bottom:2px}
  .bank-list{display:grid;gap:10px}
  .bank-row{display:grid;grid-template-columns:14px 1fr auto;gap:11px;align-items:center;padding:12px;border:1px solid #3B4453;background:#292F3A;border-radius:14px}
  .dot{width:10px;height:10px;border-radius:50%}
  .bank-row strong{display:block;font-size:14px}.bank-row small{color:#9BA6B6}
  .bank-row .amount{text-align:right;font-weight:800}
  .progress{height:7px;background:#3A4250;border-radius:99px;overflow:hidden;margin-top:7px}.progress i{display:block;height:100%;border-radius:99px}
  .insights{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}
  .insight{padding:15px;border-radius:16px;background:#252B35;border:1px solid #3B4350}
  .insight .tag{font-size:11px;color:#AAB4C2;text-transform:uppercase;font-weight:800}
  .insight b{display:block;font-size:17px;margin-top:7px}.insight p{margin:5px 0 0;color:#9CA8B8;font-size:12px;line-height:1.4}
  .table-wrap{overflow:auto;border:1px solid #39414F;border-radius:16px}
  table{width:100%;border-collapse:collapse;min-width:980px;background:#20252E}
  th{position:sticky;top:0;background:#2D3440;color:#DCE4EF;font-size:11px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:12px;border-bottom:1px solid #465061}
  td{padding:12px;border-bottom:1px solid #343C49;font-size:13px;color:#D6DEEA}
  tr:hover td{background:#252C36}
  td.num{text-align:right;font-variant-numeric:tabular-nums}
  .badge{display:inline-flex;align-items:center;gap:7px;padding:6px 9px;border-radius:999px;background:#303744;font-weight:800;font-size:11px}
  .toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
  select{appearance:none}
  .legend{display:flex;gap:14px;flex-wrap:wrap;color:#AEB8C6;font-size:12px}.legend span{display:flex;align-items:center;gap:6px}.legend i{width:9px;height:9px;border-radius:3px}
  .note{margin-top:18px;padding:13px 15px;border-radius:13px;background:#1E2530;border:1px dashed #465164;color:#AAB5C5;font-size:12px;line-height:1.5}
  .footer{display:flex;justify-content:space-between;gap:15px;color:#7F8A9B;font-size:11px;margin-top:20px;padding:0 4px;flex-wrap:wrap}
  .bank-detail-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
  .bank-card{background:#242A34;border:1px solid #3B4350;border-radius:18px;padding:16px;position:relative;overflow:hidden}
  .bank-card:before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--bank,#DC2626)}
  .bank-card .bank-title{display:flex;justify-content:space-between;gap:8px;align-items:center;font-weight:850}
  .bank-badge{padding:4px 10px;border-radius:8px;font-size:11px;font-weight:800;background:rgba(255,255,255,.08);color:#F8FAFC;border:1px solid rgba(255,255,255,.12)}
  .bank-card .big{font-size:23px;font-weight:900;margin:14px 0 3px}.bank-card .small{color:#9AA6B7;font-size:11px}
  .bank-metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.mini{background:#1D222A;padding:9px;border-radius:10px}.mini b{font-size:12px}.mini span{display:block;color:#8E9AAB;font-size:10px;margin-top:3px}

  .executive-cover{position:relative;overflow:hidden;background:linear-gradient(135deg,#242B38 0%,#1E2531 58%,#17202B 100%);border:1px solid #3B4555;border-radius:24px;padding:28px 30px;margin-bottom:18px;box-shadow:var(--shadow)}
  .executive-cover:before{content:"";position:absolute;inset:auto -80px -120px auto;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(220,38,38,.20),rgba(96,165,250,.08) 50%,transparent 72%)}
  .cover-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:28px;align-items:center;position:relative;z-index:1}
  .cover-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:#F87171;font-weight:850}
  .cover-title{font-size:clamp(28px,4vw,48px);line-height:1.03;margin:9px 0 10px;letter-spacing:-.045em;font-weight:900}
  .cover-copy{max-width:760px;color:#B6C1D0;font-size:14px;line-height:1.65}
  .cover-badges{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.cover-badges span{background:#202733;border:1px solid #3C4656;border-radius:999px;padding:8px 11px;font-size:11px;color:#D4DCE8;font-weight:700}
  .cover-bank-strip{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end}
  .cover-logo{background:linear-gradient(180deg,#2A3241,#202633);border:1px solid #3E4B60;border-radius:14px;min-height:54px;padding:8px 14px;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px rgba(0,0,0,.15);font-size:12px;font-weight:800;color:#F8FAFC}
  .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:4px 0 14px}.section-heading h2{margin:0;font-size:20px;letter-spacing:-.02em}.section-heading p{margin:4px 0 0;color:#94A0B2;font-size:12px}.section-chip{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#F87171;border:1px solid #7F1D1D;background:#2D1515;border-radius:999px;padding:7px 10px;font-weight:800}
  .bank-card{transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.bank-card:hover{transform:translateY(-2px);border-color:#536174;box-shadow:0 14px 28px rgba(0,0,0,.18)}
  .kpi{transition:transform .2s ease,border-color .2s ease}.kpi:hover{transform:translateY(-2px);border-color:#4B586A}
  
  .empty-state{text-align:center;padding:40px 20px;color:#94A0B2;font-size:14px}
  .empty-state svg{width:48px;height:48px;margin:0 auto 12px;color:#64748B}

  /* SELECTOR MULTIPAÍS GT / SV */
  .country-switcher{display:inline-flex;align-items:center;background:#181D26;border:1px solid #3B4454;border-radius:14px;padding:3px;gap:4px;box-shadow:0 4px 12px rgba(0,0,0,.15)}
  .country-pill{display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:10px;font-size:12px;font-weight:750;border:1px solid transparent;background:transparent;color:#94A3B8;cursor:pointer;transition:all .18s ease}
  .country-pill:hover{color:#F8FAFC;background:rgba(255,255,255,.06)}
  .country-pill.active{background:linear-gradient(135deg,#DC2626,#B91C1C);color:#FFFFFF;border-color:#EF4444;box-shadow:0 4px 14px rgba(220,38,38,.35)}
  .country-pill .flag{font-size:15px;line-height:1}
  .country-pill .country-curr{font-size:10px;opacity:.85;font-weight:600}
  .country-pill .country-count{display:inline-flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:999px;padding:1px 7px;font-size:10px;font-weight:800;color:#FFF}
  .btn-toggle-country{background:linear-gradient(135deg,#1E293B,#0F172A);border:1px solid #475569;color:#38BDF8;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-weight:800;cursor:pointer;transition:all .2s ease}
  .btn-toggle-country:hover{background:linear-gradient(135deg,#334155,#1E293B);border-color:#38BDF8;color:#FFFFFF;box-shadow:0 4px 12px rgba(56,189,248,.25);transform:translateY(-1px)}

  @media(max-width:1200px){.hero{grid-template-columns:minmax(0,1fr) minmax(300px,360px)}.kpis{grid-template-columns:repeat(2,minmax(200px,1fr))}.insights{grid-template-columns:repeat(2,1fr)}.bank-detail-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:820px){.date-filter{width:100%;border-radius:14px}.date-filter input[type="date"]{width:118px}.app{padding:14px}.hero{display:flex;flex-direction:column}.hero-actions{width:100%;justify-content:stretch}.kpis{grid-template-columns:1fr}.grid2,.grid-equal{grid-template-columns:1fr}.insights{grid-template-columns:1fr}.bank-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}canvas{height:280px}}
  @media(max-width:520px){.bank-detail-grid{grid-template-columns:1fr}}
  @media print{body{background:#fff;color:#111}.executive-cover{background:#fff!important;color:#111!important;border:1px solid #d7d7d7;box-shadow:none}.executive-cover:before{display:none}.cover-copy,.cover-badges span{color:#444!important}.cover-badges span{background:#fff;border-color:#ddd}.cover-logo{box-shadow:none;border-color:#ddd;background:#fff;color:#111}.app{max-width:none;padding:0}.hero,.card,.kpi,.bank-card,.insight{box-shadow:none}.hero-actions,.tabs{display:none!important}.section{display:block!important;page-break-inside:avoid;margin-bottom:20px}.hero,.card,.kpi,.bank-card,.insight{background:#fff;color:#111;border-color:#ddd}.sub,.desc,.hint,.small,.note,.footer{color:#555!important}.table-wrap{border-color:#ddd}table,td{background:#fff!important;color:#111!important}th{background:#eee!important;color:#111!important}.meta span{background:#f5f5f5;color:#333;border-color:#ddd}}
</style>
</head>
<body>
<div class="app" id="export-pdf-area">
  
  <!-- PORTADA EJECUTIVA -->
  <section class="executive-cover" aria-label="Portada ejecutiva">
    <div class="cover-grid">
      <div>
        <div class="cover-kicker">RED INTELFON · Conciliación Bancaria Consolidada</div>
        <div class="cover-title">Saldos Bancarios Consolidados</div>
        <div class="cover-copy">Informe financiero ejecutivo con auditoría integral de saldos iniciales, créditos, débitos, flujo neto y conciliación contable por banco y número de cuenta.</div>
        <div class="cover-badges">
          <span>🌍 País: <b id="coverCountry">Guatemala (GT)</b></span>
          <span>📅 Período: <b id="coverCut">—</b></span>
          <span>💵 Moneda: <b id="coverCurrency">GTQ (Q)</b></span>
          <span>🏦 <b id="coverBanks">0</b> entidades bancarias</span>
          <span>💳 <b id="coverAccounts">0</b> cuentas operadas</span>
        </div>
      </div>
      <div class="cover-bank-strip" id="coverBankLogos"></div>
    </div>
  </section>

  <!-- ENCABEZADO Y FILTROS -->
  <header class="hero">
    <div class="hero-left">
      <div class="flex items-center gap-3 mb-2 flex-wrap">
        <div class="eyebrow">Análisis financiero en tiempo real</div>
        
        <!-- SELECTOR DE PAÍS (GT / SV) -->
        <div class="country-switcher" id="countrySwitcher" role="group" aria-label="Seleccionar País">
          <button type="button" class="country-pill active" id="btn-country-gt" data-country="GT" title="Ver bancos de Guatemala">
            <span class="flag">🇬🇹</span>
            <span>Guatemala</span>
            <span class="country-curr">(Q)</span>
            <span class="country-count" id="badge-count-gt">0</span>
          </button>
          <button type="button" class="country-pill" id="btn-country-sv" data-country="SV" title="Ver bancos de El Salvador">
            <span class="flag">🇸🇻</span>
            <span>El Salvador</span>
            <span class="country-curr">($)</span>
            <span class="country-count" id="badge-count-sv">0</span>
          </button>
        </div>
      </div>

      <h1 id="mainCountryTitle">Consolidación Bancaria · Guatemala</h1>
      <div class="sub" id="mainCountrySub">Auditoría contable y evolución de saldos calculados dinámicamente para bancos de Guatemala (GTQ).</div>
      <div class="meta">
        <div class="date-filter" aria-label="Filtro de fecha">
          <span class="date-filter-title">📅 Período</span>
          <label>Desde <input type="date" id="dateFrom" aria-label="Fecha desde"></label>
          <span class="date-sep">—</span>
          <label>Hasta <input type="date" id="dateTo" aria-label="Fecha hasta"></label>
          <button type="button" class="date-apply" id="applyDateFilter">Aplicar</button>
          <button type="button" class="date-reset" id="resetDateFilter" title="Restablecer período" aria-label="Restablecer período">↺</button>
        </div>
        <span>🌍 País activo: <b id="metaCountryName">Guatemala 🇬🇹</b></span>
        <span>💵 Moneda: <b id="metaCurrency">GTQ (Q)</b></span>
        <span>🏦 <b id="bankCount">0</b> bancos</span>
        <span>💳 <b id="accountCount">0</b> cuentas</span>
        <span>🧾 Último movimiento: <b id="latestMovement">—</b></span>
      </div>
    </div>
    <div class="hero-actions">
      <!-- BOTÓN RÁPIDO DE CAMBIO DE PAÍS -->
      <button type="button" class="btn-toggle-country" id="btn-quick-toggle-country" title="Alternar entre bancos de Guatemala y El Salvador">
        <span>🇸🇻 Ver bancos SV</span>
      </button>
      <button type="button" class="btn-primary-red" id="btn-download-pdf-direct">📄 Descargar PDF Oficial</button>
      <button type="button" class="btn-excel" id="btn-download-xlsx-direct">📥 Descargar Excel (.xlsx)</button>
      <button type="button" onclick="window.print()">🖨️ Imprimir</button>
      <button type="button" onclick="toggleFullscreen()">⛶ Pantalla Completa</button>
      <button type="button" class="btn-clear-dashboard" id="btn-clear-dashboard">🧹 Limpiar dashboard</button>
    </div>
  </header>

  <!-- NAVEGACIÓN POR PESTAÑAS -->
  <nav class="tabs">
    <button class="tab active" data-target="resumen">Resumen ejecutivo</button>
    <button class="tab" data-target="bancos">Detalle por banco</button>
    <button class="tab" data-target="flujo">Flujo diario</button>
    <button class="tab" data-target="cuentas">Detalle de cuentas</button>
  </nav>

  <!-- PESTAÑA 1: RESUMEN EJECUTIVO -->
  <section id="resumen" class="section active">
    <div class="kpis" id="kpis"></div>

    <div class="grid2">
      <div class="card">
        <h2>Saldos por banco</h2>
        <div class="desc">Comparación entre saldo inicial y saldo final registrado por entidad bancaria.</div>
        <div class="legend"><span><i style="background:#60A5FA"></i>Saldo inicial</span><span><i style="background:#34D399"></i>Saldo final</span></div>
        <canvas id="balancesChart"></canvas>
      </div>
      <div class="card">
        <h2>Composición del saldo final</h2>
        <div class="desc">Participación porcentual de cada banco dentro de los fondos totales.</div>
        <div class="bank-list" id="bankList"></div>
      </div>
    </div>

    <div class="insights" id="insights"></div>

    <div class="grid-equal">
      <div class="card">
        <h2>Créditos vs. débitos por banco</h2>
        <div class="desc">Totales acumulados de ingresos y egresos registrados.</div>
        <div class="legend"><span><i style="background:#34D399"></i>Créditos</span><span><i style="background:#FB7185"></i>Débitos</span></div>
        <canvas id="flowBankChart"></canvas>
      </div>
      <div class="card">
        <h2>Flujo neto por banco</h2>
