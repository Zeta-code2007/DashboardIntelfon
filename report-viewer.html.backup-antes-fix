const PALETTE = ['#DC2626', '#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EC4899', '#06B6D4', '#64748B'];

function money(v, currency) {
  const c = currency || DATA?.meta?.currency || (CURRENT_COUNTRY === 'SV' ? 'USD' : 'GTQ');
  const sym = (c === 'USD' || c === '$' || c === 'USD$') ? '$' : 'Q';
  const num = Number(v) || 0;
  return `${sym} ${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
const pct = v => `${v >= 0 ? '+' : ''}${Number(v || 0).toFixed(2)}%`;
const cls = v => v > 0 ? 'positive' : v < 0 ? 'negative' : 'neutral';
const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
const fmtDate = iso => { if (!iso) return '—'; const parts = iso.split(/[-/]/); return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : iso; };
const periodLabel = (a, b) => (!a && !b) ? '—' : a === b ? fmtDate(a) : `${fmtDate(a)} – ${fmtDate(b)}`;
const round2 = v => Math.round((Number(v) + Number.EPSILON) * 100) / 100;

function parseJsonValue(value) {
  if (typeof value !== 'string') return value;
  const text = value.trim();
  if (!text) return value;
  try { return JSON.parse(text); } catch (_) { return value; }
}

function normalizedKey(value) {
  return String(value ?? '')
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-zA-Z0-9]/g, '')
    .toLowerCase();
}

function canonicalKey(value) {
  return normalizedKey(value).replace(/\s+/g, '');
}

function isSyntheticAccount(record) {
  const bank = canonicalKey(getField(record, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'nombre_banco', 'Entidad_Bancaria', 'Institucion_Bancaria'));
  const account = canonicalKey(getField(record, 'Cuenta', 'cuenta', 'account', 'accountNumber', 'Numero_Cuenta', 'Número de cuenta', 'numero_cuenta', 'No_Cuenta', 'No. de Cuenta', 'No. Cuenta', 'Cuenta_Bancaria', 'Tipo_Cuenta', 'Identificador_Cuenta'));
  const syntheticNames = new Set(['global', 'total', 'totales', 'consolidado', 'consolidada', 'resumen']);
  return syntheticNames.has(bank)
    || syntheticNames.has(account)
    || bank.includes('global')
    || bank.includes('consolidado')
    || account.includes('global')
    || account.includes('consolidado')
    || (/^banco\d+$/.test(bank) && /^cta\d+$/.test(account));
}

function getField(record, ...names) {
  if (!record || typeof record !== 'object' || Array.isArray(record)) return undefined;
  const fields = Object.entries(record);
  for (const name of names) {
    const match = fields.find(([key]) => normalizedKey(key) === normalizedKey(name));
    if (match) return parseJsonValue(match[1]);
  }
  return undefined;
}

function collectFields(value, names, result = [], depth = 0) {
  const parsed = parseJsonValue(value);
  if (!parsed || typeof parsed !== 'object' || depth > 8) return result;
  if (Array.isArray(parsed)) {
    parsed.forEach(item => collectFields(item, names, result, depth + 1));
    return result;
  }
  for (const [key, fieldValue] of Object.entries(parsed)) {
    if (names.some(name => normalizedKey(key) === normalizedKey(name))) {
      result.push(parseJsonValue(fieldValue));
    }
    collectFields(fieldValue, names, result, depth + 1);
  }
  return result;
}

function unwrapPayload(value, depth = 0) {
  const parsed = parseJsonValue(value);
  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || depth > 5) return parsed;
  for (const key of ['data', 'resultado', 'result', 'response', 'body', 'payload']) {
    const nested = getField(parsed, key);
    if (nested && typeof nested === 'object') return unwrapPayload(nested, depth + 1);
  }
  return parsed;
}

function asArray(value) {
  const parsed = parseJsonValue(value);
  if (Array.isArray(parsed)) return parsed;
  if (parsed && typeof parsed === 'object') {
    const values = Object.values(parsed);
    if (values.length && values.every(item => item && typeof item === 'object')) return values;
    if (getField(parsed, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'Entidad_Bancaria', 'Institucion_Bancaria')
      || getField(parsed, 'Cuenta', 'cuenta', 'account', 'accountNumber', 'Numero_Cuenta', 'Número de cuenta', 'No_Cuenta', 'No. de Cuenta', 'No. Cuenta', 'Cuenta_Bancaria', 'Tipo_Cuenta', 'Identificador_Cuenta')) return [parsed];
  }
  return [];
}

function numberValue(value, fallback = 0) {
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  const text = String(value ?? '').trim().replace(/[^0-9,.-]/g, '');
  if (!text) return fallback;
  const normalized = text.includes(',') && text.includes('.')
    ? (text.lastIndexOf(',') > text.lastIndexOf('.') ? text.replace(/\./g, '').replace(',', '.') : text.replace(/,/g, ''))
    : text.replace(',', '.');
  const result = Number(normalized);
  return Number.isFinite(result) ? result : fallback;
}

function normalizeDate(value) {
  if (typeof value === 'number' && value > 20000 && value < 100000) {
    const date = new Date(Date.UTC(1899, 11, 30) + value * 86400000);
    return date.toISOString().slice(0, 10);
  }
  const text = String(value ?? '').trim();
  const parts = text.split(/[\/-]/);
  if (parts.length === 3) {
    if (parts[0].length === 4) return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
    if (parts[2].length === 4) return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
  }
  return text || '2026-08-01';
}

/**
 * Función clasificadora robusta de País (GT vs SV)
 * Reconoce atributos explícitos, moneda, y nombres de bancos populares de cada país.
 */
function detectCountry(record, defaultCountry = 'GT') {
  if (!record || typeof record !== 'object') return defaultCountry;

  // 1. Verificación explícita de campo de país
  const cVal = String(getField(record, 'pais', 'país', 'country', 'cod_pais', 'codigo_pais', 'codPais', 'nacion', 'region', 'iso_pais', '_country') || '').trim().toLowerCase();
  if (cVal === 'sv' || cVal.includes('salvador') || cVal === 'slv') return 'SV';
  if (cVal === 'gt' || cVal.includes('guat') || cVal === 'gtm') return 'GT';

  // 2. Reconocimiento de bancos salvadoreños populares
  const bName = String(getField(record, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'nombre_banco', 'Entidad_Bancaria', 'Institucion_Bancaria') || '').toLowerCase();
  if (
    bName.includes('agricola') || bName.includes('agrícola') ||
    bName.includes('cuscatlan') || bName.includes('cuscatlán') ||
    bName.includes('davivienda sv') || bName.includes('davivienda el salvador') ||
    bName.includes('bac sv') || bName.includes('bac el salvador') ||
    bName.includes('banco azul') || bName.includes('hipotecario') ||
    bName.includes('fedecredito') || bName.includes('fedecrédito') ||
    bName.includes('promerica sv') || bName.includes('promerica el salvador') ||
    bName.includes('fomento agropecuario') || bName.includes('bancovital') ||
    bName.includes('salvador')
  ) {
    return 'SV';
  }

  // 3. Reconocimiento de bancos guatemaltecos populares
  if (
    bName.includes('industrial') || bName.includes('banrural') ||
    bName.includes('g&t') || bName.includes('gyt') ||
    bName.includes('bam') || bName.includes('agromercantil') ||
    bName.includes('chn') || bName.includes('interbanco') ||
    bName.includes('inmobiliario') || bName.includes('vivibanco') ||
    bName.includes('bantrab') || bName.includes('trabajadores') ||
    bName.includes('bac gt') || bName.includes('bac guatemala') ||
    bName.includes('promerica gt') || bName.includes('promerica guatemala') ||
    bName.includes('ficohsa gt') || bName.includes('ficohsa guatemala') ||
    bName.includes('guatemala')
  ) {
    return 'GT';
  }

  // 4. Reconocimiento por moneda
  const curr = String(getField(record, 'Moneda', 'moneda', 'currency', 'cur') || '').trim().toUpperCase();
  if (curr === 'GTQ' || curr === 'Q' || curr.includes('QUETZAL')) return 'GT';
  if (curr === 'USD' || curr === '$' || curr.includes('DOLAR') || curr.includes('DÓLAR')) {
    // Si la moneda es USD y no hay coincidencia de banco GT, categorizar en SV
    return 'SV';
  }

  return defaultCountry;
}

function mergeAccountRecords(...sources) {
  const merged = new Map();
  sources.flatMap(asArray).forEach((record) => {
    if (!record || typeof record !== 'object' || Array.isArray(record)) return;
    if (isSyntheticAccount(record)) return;
    const bank = getField(record, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'nombre_banco', 'Entidad_Bancaria', 'Institucion_Bancaria');
    const account = getField(record, 'Cuenta', 'cuenta', 'account', 'accountNumber', 'Numero_Cuenta', 'Número de cuenta', 'numero_cuenta', 'No_Cuenta', 'No. de Cuenta', 'No. Cuenta', 'Cuenta_Bancaria', 'Tipo_Cuenta', 'Identificador_Cuenta');
    if (!bank || !account) return;
    const bankName = String(bank).trim();
    const accountName = String(account).trim();
    const key = `${canonicalKey(bankName)}|${canonicalKey(accountName)}`;
    const previous = merged.get(key);
    if (!previous) {
      merged.set(key, { ...record });
      return;
    }
    for (const [field, value] of Object.entries(record)) {
      if (value === undefined || value === null || value === '') continue;
      if (Array.isArray(value)) {
        const combined = [...(Array.isArray(previous[field]) ? previous[field] : []), ...value];
        const seen = new Set();
        previous[field] = combined.filter(item => {
          const signature = JSON.stringify(item);
          if (seen.has(signature)) return false;
          seen.add(signature);
          return true;
        });
      } else if (previous[field] === undefined || previous[field] === null || previous[field] === '') {
        previous[field] = value;
      }
    }
  });
  return [...merged.values()];
}

function parseRawReport() {
  const saved = localStorage.getItem('intelfon_current_report');
  if (!saved) return null;

  try {
    let parsedJson = parseJsonValue(JSON.parse(saved));
    if (!parsedJson) return null;

    // Aceptar cualquier estructura: { data }, { resultado }, arrays, o payload plano
    let original = parsedJson.data !== undefined ? parsedJson.data : parsedJson;
    original = parseJsonValue(original);

    let sourcesArray = Array.isArray(original) ? original : [original];

    let allBancosList = [];
    let allResumenList = [];
    let fileName = 'ReporteFinanciero.xlsx';
    let outerDownloadUrl = '';
    const consolidation = { rate: null, regional: [], globalTotals: {}, files: [], review: [], countryData: {} };

    sourcesArray.forEach(src => {
      if (!src) return;
      const raw = unwrapPayload(src);
      const fName = getField(src, 'fileName', 'filename', 'nombreArchivo') || getField(raw, 'fileName', 'filename', 'nombreArchivo');
      if (fName) fileName = fName;

      const dUrl = getField(src, 'urlDescarga', 'downloadUrl', 'webViewLink', 'fileUrl', 'url', 'link')
        || getField(raw, 'urlDescarga', 'downloadUrl', 'webViewLink', 'fileUrl', 'url', 'link');
      if (dUrl && dUrl !== '#') outerDownloadUrl = dUrl;
      const excelBase64 = getField(src, 'archivoExcelBase64', 'excelBase64')
        || getField(raw, 'archivoExcelBase64', 'excelBase64')
        || (Array.isArray(src?.archivosExcel) && src.archivosExcel[0]?.data ? src.archivosExcel[0].data : '')
        || (src?.consolidadoGeneral?.data ? src.consolidadoGeneral.data : '');
      if (!outerDownloadUrl && typeof excelBase64 === 'string' && excelBase64.length > 20) {
        outerDownloadUrl = `data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,${excelBase64}`;
      }
      const rate = getField(src, 'tipoCambioGTQUSD', 'tipo_cambio_gtq_usd') || getField(raw, 'tipoCambioGTQUSD', 'tipo_cambio_gtq_usd');
      if (rate !== undefined && rate !== null && rate !== '') consolidation.rate = Number(rate);
      const regional = getField(src, 'consolidadoRegionalUSD', 'consolidado_regional_usd') || getField(raw, 'consolidadoRegionalUSD', 'consolidado_regional_usd');
      if (regional) consolidation.regional.push(...asArray(regional));
      const totals = getField(src, 'totales_globales', 'totalesGlobales') || getField(raw, 'totales_globales', 'totalesGlobales');
      if (totals && typeof totals === 'object') Object.assign(consolidation.globalTotals, totals);
      const review = getField(src, 'registrosRevision', 'registros_revision', 'revisiones') || getField(raw, 'registrosRevision', 'registros_revision', 'revisiones');
      if (review) consolidation.review.push(...asArray(review));
      const files = getField(src, 'archivosExcel', 'archivos_excel') || getField(raw, 'archivosExcel', 'archivos_excel');
      if (files) consolidation.files.push(...asArray(files));
      const generalFile = getField(src, 'consolidadoGeneral', 'consolidado_general') || getField(raw, 'consolidadoGeneral', 'consolidado_general');
      if (generalFile && typeof generalFile === 'object') consolidation.files.push({ ...generalFile, _kind: 'general' });
      for (const [code, keys] of [['GT', ['guatemala']], ['SV', ['el_salvador', 'elsalvador']]]) {
        const countryData = keys.map(key => getField(src, key) || getField(raw, key)).find(Boolean);
        if (countryData) consolidation.countryData[code] = countryData;
      }

      // Fuentes específicas de GT / SV si vienen particionadas
      const gtSpecific = collectFields(src, ['guatemala', 'gt', 'bancos_gt', 'bancos_guatemala', 'cuentas_gt']);
      const svSpecific = collectFields(src, ['el_salvador', 'salvador', 'sv', 'bancos_sv', 'bancos_salvador', 'cuentas_sv']);

      gtSpecific.flatMap(asArray).forEach(r => { if (r && typeof r === 'object') r._country = 'GT'; });
      svSpecific.flatMap(asArray).forEach(r => { if (r && typeof r === 'object') r._country = 'SV'; });

      const generalSources = collectFields(src, ['registros', 'bancos_procesados', 'bancos', 'cuentas', 'accounts', 'bank_accounts', 'cuentas_bancarias', 'bankAccounts', 'accountDetails']);
      const resumenSources = collectFields(src, ['resumen_general', 'filas', 'resumen', 'rows']);
      const balanceSources = collectFields(src, ['balance_general', 'balance', 'account_balances']);

      const merged = mergeAccountRecords(...gtSpecific, ...svSpecific, ...generalSources, ...balanceSources, ...resumenSources);
      if (merged.length) {
        allBancosList.push(...merged);
      }
      allResumenList.push(...resumenSources.flatMap(asArray));
    });

    const bancosList = mergeAccountRecords(allBancosList);
    const resumenList = allResumenList;

    downloadExcelUrl = outerDownloadUrl || '#';

    CONSOLIDATION = consolidation;
    return { bancosList, resumenList, fileName };
  } catch (e) {
    console.error('Error parseando reporte guardado:', e);
    return null;
  }
}

/**
 * Compila y construye la estructura de métricas y análisis para un país específico.
 */
function buildCountryBaseData(countryCode, accountsForCountry, transactionsForCountry, fileName) {
  const cfg = COUNTRY_CONFIG[countryCode] || COUNTRY_CONFIG.GT;
  const currency = cfg.currency;

  if (!accountsForCountry || accountsForCountry.length === 0) {
    return createEmptyBaseData(countryCode);
  }

  const accountsMap = [];
  const banksMap = {};

  accountsForCountry.forEach((b, idx) => {
    const bName = String(getField(b, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'nombre_banco', 'Entidad_Bancaria', 'Institucion_Bancaria') || `Banco ${idx + 1}`).trim();
    const accNum = String(getField(b, 'Cuenta', 'cuenta', 'account', 'accountNumber', 'Numero_Cuenta', 'Número de cuenta', 'numero_cuenta', 'No_Cuenta', 'No. de Cuenta', 'No. Cuenta', 'Cuenta_Bancaria', 'Tipo_Cuenta', 'Identificador_Cuenta') || `CTA-${idx + 1}`).trim();
    const sIni = numberValue(getField(b, 'Saldo_Inicial', 'saldo_inicial', 'saldoInicial', 'initialBalance'));
    const cIng = numberValue(getField(b, 'Total_Ingresos', 'total_ingresos', 'creditos', 'credits', 'income'));
    const dEgr = numberValue(getField(b, 'Total_Egresos', 'total_egresos', 'debitos', 'debits', 'expenses'));
    const sFinValue = getField(b, 'Saldo_Final', 'saldo_final', 'saldoFinal', 'finalBalance');
    const sFin = numberValue(sFinValue ?? (sIni + cIng - dEgr));

    accountsMap.push({
      bankKey: bName,
      bank: bName,
      account: accNum,
      initial: sIni,
      final: sFin,
      change: round2(sFin - sIni),
      changePct: sIni !== 0 ? round2(((sFin - sIni) / Math.abs(sIni)) * 100) : 0,
      credits: cIng,
      debits: dEgr,
      country: countryCode
    });

    const bankKey = canonicalKey(bName);
    if (!banksMap[bankKey]) {
      banksMap[bankKey] = {
        key: bName,
        name: bName,
        color: PALETTE[Object.keys(banksMap).length % PALETTE.length],
        initial: 0,
        final: 0,
        credits: 0,
        debits: 0,
        accountsCount: 0,
        country: countryCode
      };
    }
    banksMap[bankKey].initial += sIni;
    banksMap[bankKey].final += sFin;
    banksMap[bankKey].credits += cIng;
    banksMap[bankKey].debits += dEgr;
    banksMap[bankKey].accountsCount += 1;
  });

  const totalFinalAll = Object.values(banksMap).reduce((s, b) => s + b.final, 0) || 1;
  const banksArray = Object.values(banksMap).map(b => ({
    ...b,
    initial: round2(b.initial),
    final: round2(b.final),
    change: round2(b.final - b.initial),
    changePct: b.initial !== 0 ? round2(((b.final - b.initial) / Math.abs(b.initial)) * 100) : 0,
    credits: round2(b.credits),
    debits: round2(b.debits),
    netFlow: round2(b.credits - b.debits),
    share: round2((b.final / totalFinalAll) * 100),
    accounts: b.accountsCount
  }));

  const minDate = transactionsForCountry.length ? transactionsForCountry.reduce((m, t) => !m || t.date < m ? t.date : m, '') : '';
  const maxDate = transactionsForCountry.length ? transactionsForCountry.reduce((m, t) => !m || t.date > m ? t.date : m, '') : '';

  return {
    meta: {
      file: fileName,
      fileCut: periodLabel(minDate, maxDate),
      latestMovement: maxDate ? fmtDate(maxDate) : 'Reciente',
      currency: currency,
      country: cfg.code,
      countryName: cfg.name,
      countryFlag: cfg.flag,
      accounts: accountsMap.length,
      banks: banksArray.length,
      movementCount: transactionsForCountry.length || accountsMap.length,
      minDate,
      maxDate
    },
    totals: {
      initial: round2(banksArray.reduce((s, b) => s + b.initial, 0)),
      final: round2(banksArray.reduce((s, b) => s + b.final, 0)),
      change: round2(banksArray.reduce((s, b) => s + (b.final - b.initial), 0)),
      changePct: banksArray.reduce((sum, bank) => sum + bank.initial, 0) !== 0
        ? round2((banksArray.reduce((sum, bank) => sum + bank.change, 0) / Math.abs(banksArray.reduce((sum, bank) => sum + bank.initial, 0))) * 100)
        : 0,
      credits: round2(banksArray.reduce((s, b) => s + b.credits, 0)),
      debits: round2(banksArray.reduce((s, b) => s + b.debits, 0)),
      netFlow: round2(banksArray.reduce((s, b) => s + (b.credits - b.debits), 0))
    },
    highlights: { maxCredit: null, maxDebit: null, maxNet: null, minNet: null },
    banks: banksArray,
    accounts: accountsMap,
    daily: []
  };
}

function initDataEngine() {
  const parsed = parseRawReport();
  loadedReportSnapshot = localStorage.getItem('intelfon_current_report');
  RAW_TRANSACTIONS_BY_COUNTRY = { GT: [], SV: [] };
  CONSOLIDATION = { rate: null, regional: [], globalTotals: {}, files: [], review: [], countryData: {} };

  if (!parsed || !Array.isArray(parsed.bancosList) || parsed.bancosList.length === 0) {
    BASE_DATA_BY_COUNTRY = {
      GT: createEmptyBaseData('GT'),
      SV: createEmptyBaseData('SV')
    };
    updateCountryBadges();
    applyCountry(CURRENT_COUNTRY);
    return;
  }

  const { bancosList, fileName } = parsed;
  const accountsByCountry = { GT: [], SV: [] };
  const transactionKeys = new Set();

  bancosList.forEach((b, idx) => {
    const countryCode = detectCountry(b, 'GT');
    accountsByCountry[countryCode].push(b);

    const bName = String(getField(b, 'Banco', 'banco', 'bank', 'bankName', 'Nombre_Banco', 'Nombre del Banco', 'nombre_banco', 'Entidad_Bancaria', 'Institucion_Bancaria') || `Banco ${idx + 1}`).trim();
    const accNum = String(getField(b, 'Cuenta', 'cuenta', 'account', 'accountNumber', 'Numero_Cuenta', 'Número de cuenta', 'numero_cuenta', 'No_Cuenta', 'No. de Cuenta', 'No. Cuenta', 'Cuenta_Bancaria', 'Tipo_Cuenta', 'Identificador_Cuenta') || `CTA-${idx + 1}`).trim();
    const sIni = numberValue(getField(b, 'Saldo_Inicial', 'saldo_inicial', 'saldoInicial', 'initialBalance'));
    const cIng = numberValue(getField(b, 'Total_Ingresos', 'total_ingresos', 'creditos', 'credits', 'income'));
    const dEgr = numberValue(getField(b, 'Total_Egresos', 'total_egresos', 'debitos', 'debits', 'expenses'));
    const sFinValue = getField(b, 'Saldo_Final', 'saldo_final', 'saldoFinal', 'finalBalance');
    const sFin = numberValue(sFinValue ?? (sIni + cIng - dEgr));

    // Extraer transacciones reales si vienen en el payload
    const movs = asArray(getField(b, 'estado_cuenta', 'estado cuenta', 'Movimientos', 'movimientos', 'transactions', 'transacciones'));
    if (movs.length) {
      movs.forEach((m, mIdx) => {
        const d = normalizeDate(getField(m, 'Fecha', 'fecha', 'date'));
        const debit = numberValue(getField(m, 'Egreso', 'Debito', 'debito', 'debit', 'debits'));
        const credit = numberValue(getField(m, 'Ingreso', 'Credito', 'credito', 'credit', 'credits'));
        const reference = getField(m, 'No_Referencia', 'referencia', 'reference', 'id') || '';
        const transactionKey = `${canonicalKey(bName)}|${canonicalKey(accNum)}|${d}|${reference}|${debit}|${credit}|${getField(m, 'Descripcion', 'descripcion', 'description') || ''}`;
        if (transactionKeys.has(transactionKey)) return;
        transactionKeys.add(transactionKey);
        RAW_TRANSACTIONS_BY_COUNTRY[countryCode].push({
          row: mIdx,
          country: countryCode,
          bankKey: bName,
          bank: bName,
          account: accNum,
          date: d,
          debit,
          credit,
          balance: numberValue(getField(m, 'Saldo_Resultante', 'Saldo', 'saldo', 'balance'), sFin)
        });
      });
    }
  });

  BASE_DATA_BY_COUNTRY = {
    GT: buildCountryBaseData('GT', accountsByCountry.GT, RAW_TRANSACTIONS_BY_COUNTRY.GT, fileName),
    SV: buildCountryBaseData('SV', accountsByCountry.SV, RAW_TRANSACTIONS_BY_COUNTRY.SV, fileName)
  };

  updateCountryBadges();
  applyCountry(CURRENT_COUNTRY);
}

