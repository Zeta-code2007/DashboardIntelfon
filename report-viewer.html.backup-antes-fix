 * Cambia el país activo (GT o SV) y recalcula la vista completa
 */
function setCountry(countryCode) {
  if (countryCode !== 'GT' && countryCode !== 'SV') return;
  CURRENT_COUNTRY = countryCode;
  updateCountryBadges();
  applyCountry(countryCode);
}

function applyCountry(countryCode) {
  const baseData = BASE_DATA_BY_COUNTRY[countryCode] || BASE_DATA_BY_COUNTRY.GT;
  const rawTx = RAW_TRANSACTIONS_BY_COUNTRY[countryCode] || [];

  const minDate = baseData.meta.minDate || '';
  const maxDate = baseData.meta.maxDate || '';

  const dFrom = document.getElementById('dateFrom');
  const dTo = document.getElementById('dateTo');
  if (dFrom && dTo) {
    dFrom.min = minDate; dFrom.max = maxDate; dFrom.value = minDate;
    dTo.min = minDate; dTo.max = maxDate; dTo.value = maxDate;
  }

  DATA = buildFiltered(countryCode, minDate, maxDate);
  renderAll();
}

function buildFiltered(countryCode, startDate, endDate) {
  const baseData = BASE_DATA_BY_COUNTRY[countryCode] || BASE_DATA_BY_COUNTRY.GT;
  const rawTx = RAW_TRANSACTIONS_BY_COUNTRY[countryCode] || [];

  if (!baseData.banks.length || !rawTx.length) {
    return baseData;
  }

  const reportStart = rawTx.reduce((min, t) => !min || t.date < min ? t.date : min, '');
  const reportEnd = rawTx.reduce((max, t) => !max || t.date > max ? t.date : max, '');
  const isCompletePeriod = startDate <= reportStart && endDate >= reportEnd;

  const inRange = rawTx.filter(t => t.date >= startDate && t.date <= endDate);

  const byDate = {};
  inRange.forEach(t => {
    const d = byDate[t.date] || (byDate[t.date] = { date: t.date, moves: 0, debits: 0, credits: 0 });
    d.moves += 1;
    d.debits += Number(t.debit || 0);
    d.credits += Number(t.credit || 0);
  });

  const daily = Object.values(byDate).sort((a, b) => a.date.localeCompare(b.date)).map(d => ({
    date: d.date,
    label: fmtDate(d.date).slice(0, 5),
    moves: d.moves,
    debits: round2(d.debits),
    credits: round2(d.credits),
    net: round2(d.credits - d.debits)
  }));

  const maxCredit = daily.length ? daily.reduce((a, b) => b.credits > a.credits ? b : a) : null;
  const maxDebit = daily.length ? daily.reduce((a, b) => b.debits > a.debits ? b : a) : null;
  const maxNet = daily.length ? daily.reduce((a, b) => b.net > a.net ? b : a) : null;
  const minNet = daily.length ? daily.reduce((a, b) => b.net < a.net ? b : a) : null;

  const filteredCredits = round2(daily.reduce((sum, day) => sum + day.credits, 0));
  const filteredDebits = round2(daily.reduce((sum, day) => sum + day.debits, 0));
  const filteredNetFlow = round2(filteredCredits - filteredDebits);
  const filteredFinal = round2(baseData.totals.initial + filteredNetFlow);
  const totals = isCompletePeriod
    ? { ...baseData.totals }
    : {
        ...baseData.totals,
        final: filteredFinal,
        change: filteredNetFlow,
        changePct: baseData.totals.initial !== 0
          ? round2((filteredNetFlow / Math.abs(baseData.totals.initial)) * 100)
          : 0,
        credits: filteredCredits,
        debits: filteredDebits,
        netFlow: filteredNetFlow
      };

  return {
    meta: {
      ...baseData.meta,
      fileCut: periodLabel(startDate, endDate),
      latestMovement: inRange.length ? fmtDate(inRange[inRange.length - 1].date) : baseData.meta.latestMovement,
      movementCount: inRange.length || baseData.meta.movementCount
    },
    totals,
    highlights: { maxCredit, maxDebit, maxNet, minNet },
    banks: baseData.banks,
    accounts: baseData.accounts,
    daily: daily
  };
}

