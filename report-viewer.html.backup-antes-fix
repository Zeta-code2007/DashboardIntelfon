// ===========================================================================
// MOTOR DE ANIMACIONES FLUIDAS, EFECTOS VISUALES Y SCROLL-TRIGGER
// ===========================================================================

const CHART_ANIMATIONS = {};
let HOVERED_CHART_ITEM = {};

function easeOutQuart(x) {
  return 1 - Math.pow(1 - x, 4);
}

function easeOutBack(x) {
  const c1 = 1.70158;
  const c3 = c1 + 1;
  return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
}

function animateChart(chartId, renderFn, duration = 750) {
  if (CHART_ANIMATIONS[chartId]) {
    cancelAnimationFrame(CHART_ANIMATIONS[chartId]);
  }
  const startTime = performance.now();
  function step(now) {
    const elapsed = now - startTime;
    const rawProgress = Math.min(elapsed / duration, 1);
    const progress = easeOutQuart(rawProgress);
    renderFn(progress);
    if (rawProgress < 1) {
      CHART_ANIMATIONS[chartId] = requestAnimationFrame(step);
    } else {
      delete CHART_ANIMATIONS[chartId];
    }
  }
  CHART_ANIMATIONS[chartId] = requestAnimationFrame(step);
}

// Canvas Gráficas con Soporte Retina / HiDPI y Protección de Dimensiones Ocultas
function fitCanvas(canvas) {
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  const parentWidth = canvas.parentElement ? canvas.parentElement.clientWidth - 40 : 600;
  const width = rect.width > 50 ? rect.width : (parentWidth > 50 ? parentWidth : 600);
  const height = rect.height > 50 ? rect.height : 330;
  canvas.width = Math.max(300, Math.floor(width * dpr));
  canvas.height = Math.max(200, Math.floor(height * dpr));
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  return { ctx, w: width, h: height };
}

function roundedRect(ctx, x, y, w, h, r, fill, glow = null) {
  ctx.save();
  if (glow) {
    ctx.shadowColor = glow.color || fill;
    ctx.shadowBlur = glow.blur || 12;
    ctx.shadowOffsetY = glow.offsetY || 0;
  }
  ctx.beginPath();
  ctx.roundRect(x, y, Math.max(w, 2), Math.max(h, 2), r);
  ctx.fillStyle = fill;
  ctx.fill();
  ctx.restore();
}

function text(ctx, t, x, y, opt = {}) {
  ctx.save();
  ctx.fillStyle = opt.color || '#D9E1EC';
  ctx.font = `${opt.weight || 600} ${opt.size || 12}px Inter,Segoe UI,Arial`;
  ctx.textAlign = opt.align || 'left';
  ctx.textBaseline = 'middle';
  if (opt.shadow) {
    ctx.shadowColor = opt.shadowColor || 'rgba(0,0,0,0.6)';
    ctx.shadowBlur = opt.shadowBlur || 4;
  }
  ctx.fillText(t, x, y);
  ctx.restore();
}

function chartTooltip(canvas, getHit) {
  let tip = canvas.parentElement.querySelector('.chart-tooltip');
  if (!tip) {
    tip = document.createElement('div');
    tip.className = 'chart-tooltip';
    canvas.parentElement.appendChild(tip);
  }

  canvas._chartHitTest = getHit;
  if (canvas._chartInteractive) return;
  canvas._chartInteractive = true;

  canvas.addEventListener('pointermove', event => {
    const rect = canvas.getBoundingClientRect();
    const hit = canvas._chartHitTest(event.clientX - rect.left, event.clientY - rect.top);
    if (!hit) {
      tip.classList.remove('visible');
      if (HOVERED_CHART_ITEM[canvas.id] !== null) {
        HOVERED_CHART_ITEM[canvas.id] = null;
        drawSingleChart(canvas.id);
      }
      return;
    }
    if (HOVERED_CHART_ITEM[canvas.id] !== hit.index) {
      HOVERED_CHART_ITEM[canvas.id] = hit.index;
      drawSingleChart(canvas.id);
    }
    tip.innerHTML = hit.html;
    tip.style.left = `${Math.min(Math.max(hit.x, 8), rect.width - tip.offsetWidth - 8)}px`;
    tip.style.top = `${Math.max(8, hit.y - tip.offsetHeight - 14)}px`;
    tip.classList.add('visible');
  });

  canvas.addEventListener('pointerleave', () => {
    tip.classList.remove('visible');
    if (HOVERED_CHART_ITEM[canvas.id] !== null) {
      HOVERED_CHART_ITEM[canvas.id] = null;
      drawSingleChart(canvas.id);
    }
  });
}

function createGradient(ctx, x1, y1, x2, y2, colorStart, colorEnd) {
  const grad = ctx.createLinearGradient(x1, y1, x2, y2);
  grad.addColorStop(0, colorStart);
  grad.addColorStop(1, colorEnd);
  return grad;
}

function drawGroupedBars(id, labels, s1, s2, c1, c2, progress = 1) {
  const canvas = document.getElementById(id);
  if (!canvas || !canvas.offsetParent) return;
  const { ctx, w, h } = fitCanvas(canvas);
  ctx.clearRect(0, 0, w, h);

  const cur = DATA?.meta?.currency || (CURRENT_COUNTRY === 'SV' ? 'USD' : 'GTQ');

  if (!labels.length) {
    text(ctx, 'Sin datos para graficar en este país', w / 2, h / 2, { align: 'center', color: '#64748B' });
    return;
  }

  const L = 85, R = 18, T = 25, B = 45, pw = w - L - R, ph = h - T - B;
  const max = Math.max(...s1, ...s2, 1) * 1.15;
  const hoveredIdx = HOVERED_CHART_ITEM[id];

  // Líneas guía de fondo suaves
  ctx.strokeStyle = '#2F3746';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = T + ph * i / 4;
    ctx.beginPath();
    ctx.moveTo(L, y);
    ctx.lineTo(w - R, y);
    ctx.stroke();
    text(ctx, money(max * (1 - i / 4), cur), L - 8, y, { size: 10, color: '#8F9AAB', align: 'right', weight: 500 });
  }

  const group = pw / labels.length, bw = Math.min(32, group * .28);

  labels.forEach((lab, i) => {
    const cx = L + group * (i + .5);
    const h1 = ph * Math.max((s1[i] || 0) * progress, 0) / max;
    const h2 = ph * Math.max((s2[i] || 0) * progress, 0) / max;

    const isHovered = hoveredIdx === i;

    // Colores con degradado profesional
    const grad1 = createGradient(ctx, 0, T + ph - h1, 0, T + ph, c1, `${c1}88`);
    const grad2 = createGradient(ctx, 0, T + ph - h2, 0, T + ph, c2, `${c2}88`);

    // Barra 1 (Saldo inicial / Créditos)
    roundedRect(
      ctx, cx - bw - 3, T + ph - h1, bw, h1, 6, grad1,
      isHovered ? { color: c1, blur: 14 } : null
    );

    // Barra 2 (Saldo final / Débitos)
    roundedRect(
      ctx, cx + 3, T + ph - h2, bw, h2, 6, grad2,
      isHovered ? { color: c2, blur: 14 } : null
    );

    // Etiqueta del banco con realce si está en hover
    text(ctx, lab, cx, h - B / 2 + 15, {
      size: isHovered ? 11 : 10,
      color: isHovered ? '#FFFFFF' : '#B8C2D1',
      align: 'center',
      weight: isHovered ? 800 : 700
    });
  });

  chartTooltip(canvas, (px, py) => {
    const group = pw / labels.length;
    const index = Math.floor((px - L) / group);
    if (index < 0 || index >= labels.length || py < T || py > T + ph) return null;
    return {
      index,
      x: L + group * (index + 0.5),
      y: T + ph - Math.max(ph * Math.max(s1[index] || 0, s2[index] || 0) / max, 8),
      html: `<strong>${esc(labels[index])}</strong><span style="color:${c1}">Inicial: ${money(s1[index], cur)}</span><span style="color:${c2}">Final: ${money(s2[index], cur)}</span>`
    };
  });
}

function drawNetBars(progress = 1) {
  const canvas = document.getElementById('netBankChart');
  if (!canvas || !canvas.offsetParent) return;
  const { ctx, w, h } = fitCanvas(canvas);
  ctx.clearRect(0, 0, w, h);

  const cur = DATA?.meta?.currency || (CURRENT_COUNTRY === 'SV' ? 'USD' : 'GTQ');

  if (!DATA.banks.length) {
    text(ctx, 'Sin datos para graficar en este país', w / 2, h / 2, { align: 'center', color: '#64748B' });
    return;
  }

  const vals = DATA.banks.map(b => b.netFlow);
  const labels = DATA.banks.map(b => b.name.replace('Banco ', ''));
  const L = 85, R = 20, T = 25, B = 45, pw = w - L - R, ph = h - T - B;
  const max = Math.max(...vals.map(Math.abs), 1) * 1.15;
  const mid = T + ph / 2;
  const hoveredIdx = HOVERED_CHART_ITEM['netBankChart'];

  // Eje central neutral
  ctx.strokeStyle = '#4B5565';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(L, mid);
  ctx.lineTo(w - R, mid);
  ctx.stroke();

  const group = pw / vals.length, bw = Math.min(48, group * .48);

  vals.forEach((v, i) => {
    const barh = ((ph / 2) * Math.abs(v) / max) * progress;
    const cx = L + group * (i + .5);
    const y = v >= 0 ? mid - barh : mid;
    const isPositive = v >= 0;
    const isHovered = hoveredIdx === i;

    const barColor = isPositive ? '#34D399' : '#FB7185';
    const grad = createGradient(
      ctx, 0, isPositive ? y : y + barh, 0, isPositive ? y + barh : y,
      barColor,
      isPositive ? '#059669' : '#E11D48'
    );

    roundedRect(
      ctx, cx - bw / 2, y, bw, barh, 7, grad,
      isHovered ? { color: barColor, blur: 16 } : null
    );

    text(ctx, labels[i], cx, h - 18, {
      size: isHovered ? 11 : 10,
      color: isHovered ? '#FFFFFF' : '#B8C2D1',
      align: 'center',
      weight: isHovered ? 800 : 700
    });

    if (progress > 0.6) {
      const labelY = isPositive ? Math.max(T + 10, y - 10) : Math.min(h - B - 5, y + barh + 12);
      text(ctx, money(v, cur), cx, labelY, {
        size: 10,
        color: isPositive ? '#6EE7B7' : '#FDA4AF',
        align: 'center',
        weight: 750
      });
    }
  });

  chartTooltip(canvas, (px, py) => {
    const group = pw / vals.length;
    const index = Math.floor((px - L) / group);
    if (index < 0 || index >= vals.length || py < T || py > T + ph) return null;
    return {
      index,
      x: L + group * (index + 0.5),
      y: mid - (ph / 2) * Math.abs(vals[index]) / max,
      html: `<strong>${esc(labels[index])}</strong><span style="color:${vals[index] >= 0 ? '#6EE7B7' : '#FDA4AF'}">Flujo neto: ${money(vals[index], cur)}</span>`
    };
  });
}

function drawDaily(progress = 1) {
  const canvas = document.getElementById('dailyChart');
  if (!canvas || !canvas.offsetParent) return;
  const { ctx, w, h } = fitCanvas(canvas);
  ctx.clearRect(0, 0, w, h);

  const cur = DATA?.meta?.currency || (CURRENT_COUNTRY === 'SV' ? 'USD' : 'GTQ');

  if (!DATA.daily.length) {
    text(ctx, 'Sin movimientos diarios en el período seleccionado', w / 2, h / 2, { size: 13, color: '#94A0B2', align: 'center', weight: 650 });
    return;
  }

  const L = 80, R = 20, T = 24, B = 48, pw = w - L - R, ph = h - T - B;
  const vals = [...DATA.daily.map(d => d.credits), ...DATA.daily.map(d => d.debits)];
  const max = Math.max(...vals, 1) * 1.1;
  const hoveredIdx = HOVERED_CHART_ITEM['dailyChart'];

  ctx.strokeStyle = '#2F3746';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = T + ph * i / 4;
    ctx.beginPath();
    ctx.moveTo(L, y);
    ctx.lineTo(w - R, y);
    ctx.stroke();
    text(ctx, money(max * (1 - i / 4), cur), L - 8, y, { size: 10, color: '#8F9AAB', align: 'right', weight: 500 });
  }

  const totalPoints = DATA.daily.length;
  const animatedPointsCount = Math.max(2, Math.floor(totalPoints * progress));

  const x = i => L + pw * (i / (totalPoints - 1 || 1));
  const y = v => T + ph - (v / max * ph);

  // 1. Áreas con degradado translúcido debajo de las curvas
  function drawArea(key, colorStart, colorEnd) {
    if (animatedPointsCount < 2) return;
    ctx.save();
    const grad = ctx.createLinearGradient(0, T, 0, T + ph);
    grad.addColorStop(0, colorStart);
    grad.addColorStop(1, colorEnd);
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(x(0), T + ph);
    for (let i = 0; i < animatedPointsCount; i++) {
      ctx.lineTo(x(i), y(DATA.daily[i][key]));
    }
    ctx.lineTo(x(animatedPointsCount - 1), T + ph);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  drawArea('credits', 'rgba(52, 211, 153, 0.22)', 'rgba(52, 211, 153, 0.0)');
  drawArea('debits', 'rgba(251, 113, 133, 0.18)', 'rgba(251, 113, 133, 0.0)');

  // 2. Trazado de líneas principales con brillo
  function line(key, color, glowColor) {
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2.8;
    ctx.shadowColor = glowColor;
    ctx.shadowBlur = 8;
    ctx.beginPath();
    for (let i = 0; i < animatedPointsCount; i++) {
      const xx = x(i), yy = y(DATA.daily[i][key]);
      i ? ctx.lineTo(xx, yy) : ctx.moveTo(xx, yy);
    }
    ctx.stroke();
    ctx.restore();

    // Puntos (Dots)
    for (let i = 0; i < animatedPointsCount; i++) {
      const isHov = hoveredIdx === i;
      ctx.save();
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(x(i), y(DATA.daily[i][key]), isHov ? 5.5 : 3.2, 0, Math.PI * 2);
      ctx.fill();
      if (isHov) {
        ctx.strokeStyle = '#FFFFFF';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
      ctx.restore();
    }
  }

  line('credits', '#34D399', 'rgba(52, 211, 153, 0.6)');
  line('debits', '#FB7185', 'rgba(251, 113, 133, 0.6)');

  // 3. Guía radar vertical al pasar el cursor
  if (hoveredIdx !== undefined && hoveredIdx !== null && hoveredIdx < totalPoints) {
    const hx = x(hoveredIdx);
    ctx.save();
    ctx.strokeStyle = 'rgba(96, 165, 250, 0.5)';
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(hx, T);
    ctx.lineTo(hx, T + ph);
    ctx.stroke();
    ctx.restore();
  }

  DATA.daily.forEach((d, i) => {
    if (i % 2 === 0 || DATA.daily.length < 12) {
      text(ctx, d.label, x(i), h - 18, { size: 9, color: '#9BA6B6', align: 'center', weight: 600 });
    }
  });

  chartTooltip(canvas, (px, py) => {
    const index = Math.round((px - L) / (pw / (DATA.daily.length - 1 || 1)));
    if (index < 0 || index >= DATA.daily.length || py < T || py > T + ph) return null;
    const day = DATA.daily[index];
    return {
      index,
      x: x(index),
      y: Math.min(y(day.credits), y(day.debits)),
      html: `<strong>${esc(day.label)}</strong><span style="color:#34D399">Créditos: ${money(day.credits, cur)}</span><span style="color:#FB7185">Débitos: ${money(day.debits, cur)}</span><span>Flujo neto: ${money(day.net, cur)}</span>`
    };
  });
}

function drawSingleChart(id) {
  if (id === 'balancesChart') {
    drawGroupedBars('balancesChart', DATA.banks.map(b => b.name.replace('Banco ', '')), DATA.banks.map(b => b.initial), DATA.banks.map(b => b.final), '#60A5FA', '#34D399', 1);
  } else if (id === 'flowBankChart') {
    drawGroupedBars('flowBankChart', DATA.banks.map(b => b.name.replace('Banco ', '')), DATA.banks.map(b => b.credits), DATA.banks.map(b => b.debits), '#34D399', '#FB7185', 1);
  } else if (id === 'netBankChart') {
    drawNetBars(1);
  } else if (id === 'dailyChart') {
    drawDaily(1);
  }
}

function triggerChartAnimation(id) {
  if (id === 'balancesChart') {
    animateChart('balancesChart', p => drawGroupedBars('balancesChart', DATA.banks.map(b => b.name.replace('Banco ', '')), DATA.banks.map(b => b.initial), DATA.banks.map(b => b.final), '#60A5FA', '#34D399', p), 750);
  } else if (id === 'flowBankChart') {
    animateChart('flowBankChart', p => drawGroupedBars('flowBankChart', DATA.banks.map(b => b.name.replace('Banco ', '')), DATA.banks.map(b => b.credits), DATA.banks.map(b => b.debits), '#34D399', '#FB7185', p), 750);
  } else if (id === 'netBankChart') {
    animateChart('netBankChart', p => drawNetBars(p), 750);
  } else if (id === 'dailyChart') {
    animateChart('dailyChart', p => drawDaily(p), 850);
  }
}

function drawAll(animate = true) {
  if (!DATA) return;
  if (animate) {
    if (document.getElementById('balancesChart')) triggerChartAnimation('balancesChart');
    if (document.getElementById('flowBankChart')) triggerChartAnimation('flowBankChart');
    if (document.getElementById('netBankChart')) triggerChartAnimation('netBankChart');
    if (document.getElementById('dailyChart')) triggerChartAnimation('dailyChart');
  } else {
    if (document.getElementById('balancesChart')) drawSingleChart('balancesChart');
    if (document.getElementById('flowBankChart')) drawSingleChart('flowBankChart');
    if (document.getElementById('netBankChart')) drawSingleChart('netBankChart');
    if (document.getElementById('dailyChart')) drawSingleChart('dailyChart');
  }
}

// Observador IntersectionObserver para disparar animaciones al scrollear hacia las gráficas
const chartScrollObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const canvas = entry.target.querySelector('canvas') || (entry.target.tagName === 'CANVAS' ? entry.target : null);
      if (canvas && canvas.id) {
        triggerChartAnimation(canvas.id);
      }
    }
  });
}, { threshold: 0.18 });

function registerChartObservers() {
  document.querySelectorAll('.card').forEach(card => {
    if (card.querySelector('canvas')) {
      chartScrollObserver.observe(card);
    }
  });
}

window.addEventListener('resize', () => setTimeout(() => drawAll(false), 80));
setTimeout(registerChartObservers, 200);

window.addEventListener('resize', () => setTimeout(drawAll, 80));
function toggleFullscreen() { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.(); }

// Manejador de descarga de PDF Oficial Directo (html2pdf)
const btnDownloadPdf = document.getElementById('btn-download-pdf-direct');
if (btnDownloadPdf) {
  btnDownloadPdf.addEventListener('click', () => {
    const cfg = COUNTRY_CONFIG[CURRENT_COUNTRY] || COUNTRY_CONFIG.GT;
    const element = document.getElementById('export-pdf-area');
    const opt = {
      margin: [10, 10, 10, 10],
      filename: `Reporte_Bancario_${cfg.name}_INTELFON.pdf`,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, backgroundColor: '#171A21' },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
    };
    html2pdf().set(opt).from(element).save();
  });
}

// Manejador de descarga de Excel (.xlsx)
const btnDownloadXlsx = document.getElementById('btn-download-xlsx-direct');
if (btnDownloadXlsx) {
  btnDownloadXlsx.addEventListener('click', () => {
    if (!downloadExcelUrl || downloadExcelUrl === '#') {
      alert('El enlace de descarga del archivo Excel no está disponible en esta sesión.');
      return;
    }
    let directUrl = downloadExcelUrl;
    const driveMatch = downloadExcelUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) || downloadExcelUrl.match(/id=([a-zA-Z0-9_-]+)/);
    if (driveMatch && driveMatch[1]) {
      directUrl = `https://drive.google.com/uc?export=download&id=${driveMatch[1]}`;
    }
    window.open(directUrl, '_blank');
  });
}

const btnClearDashboard = document.getElementById('btn-clear-dashboard');
if (btnClearDashboard) {
  btnClearDashboard.addEventListener('click', () => {
    if (!confirm('¿Deseas limpiar todos los datos del dashboard? Esta acción no elimina el archivo original.')) return;
    localStorage.removeItem('intelfon_current_report');
    sessionStorage.removeItem('intelfon_current_report');
    localStorage.removeItem('intelfon_processing_id');
    sessionStorage.removeItem('intelfon_processing_id');
    window.dispatchEvent(new CustomEvent('intelfon-report-updated', {
      detail: { key: 'intelfon_current_report', value: null }
    }));
    window.parent.postMessage({ type: 'intelfon-report-cleared' }, '*');
    downloadExcelUrl = '#';
    initDataEngine();
  });
}

// Inicialización dinámica
document.addEventListener('DOMContentLoaded', () => {
  if (new URLSearchParams(window.location.search).get('compact') === '1') {
    document.querySelector('.tabs')?.remove();
  }
  initDataEngine();
  syncActiveTabFromLocation();
  setInterval(() => {
    const currentSnapshot = localStorage.getItem('intelfon_current_report');
    if (currentSnapshot !== loadedReportSnapshot) {
      initDataEngine();
      syncActiveTabFromLocation();
    }
  }, 500);
});
</script>
